# =============================================================
# Project-root .htaccess
# Serves everything from /public while the server's document root
# is the project root. Nothing outside /public is reachable.
# (Not needed if the host's document root points at /public.)
# =============================================================

Options -Indexes
RewriteEngine On

# 1. If /public/... is requested directly, redirect to the clean URL
#    (/public/services/ → /services/), so "public" never shows in URLs.
#    THE_REQUEST is the browser's original request, so internal
#    rewrites below can't trigger this rule and cause a loop.
RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2. Add the trailing slash to folders inside /public
#    (/services → /services/). Without this, Apache adds it itself
#    and exposes /public/ in the redirected URL.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# 3. Send every other request into /public.
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]